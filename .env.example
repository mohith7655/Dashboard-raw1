# Template only — never put real values in this file, it is tracked in git.
# Copy it to `.env` (gitignored) for local development, and set the real
# values in Netlify under Project configuration → Environment variables.
#
# These are read by Netlify Functions and are never exposed to the browser.
# Do not prefix secrets with `VITE_`.

# Metorik (WooCommerce revenue, orders, customers, costs)
METORIK_API_KEY=

# Facebook Meta Ads (Marketing Insights API)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Only when the account is reached through a manager (MCC) account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Google Analytics 4 (Traffic tab breakdowns)
# Numeric property id, not the G-XXXXXXX measurement id.
GA4_PROPERTY_ID=
# Needs the analytics.readonly scope. An Ads-only token will not work here —
# run `npm run google:auth` to mint one that carries every Google scope the
# dashboard uses. Falls back to the GOOGLE_ADS_* values when left blank.
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REFRESH_TOKEN=

# Google Search Console (Search & Feed tab — organic search)
# The property exactly as Search Console names it: `sc-domain:example.com` for a
# domain property, or the full origin including the trailing slash for a URL-prefix
# one, e.g. `https://example.com/`.
GSC_SITE_URL=
# Needs the webmasters.readonly scope. Left blank, the GA4_* credentials are
# used — `npm run google:auth` mints one token that carries every scope.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# Google Merchant Center (Search & Feed tab — product feed health)
# The numeric merchant id shown in Merchant Center. Needs the `content` scope
# and the Content API for Shopping enabled in the Google Cloud project.
GMC_MERCHANT_ID=
# Only under a multi-client account, where the caller is the MCA and this is the
# sub-account being asked about. Defaults to GMC_MERCHANT_ID.
GMC_ACCOUNT_ID=
# Left blank, the GA4_* credentials are used.
GMC_CLIENT_ID=
GMC_CLIENT_SECRET=
GMC_REFRESH_TOKEN=

# Lead Data (Make.com Google Sheet)
# Spreadsheet id from the Google Sheets URL. A public sheet can be read without
# a token; private sheets need the readonly Sheets scope on LEADS_REFRESH_TOKEN
# (or GA4_REFRESH_TOKEN as a fallback).
LEADS_SHEET_ID=
LEADS_CLIENT_ID=
LEADS_CLIENT_SECRET=
LEADS_REFRESH_TOKEN=

# Markifact (Markifact tab — the automation workspace)
# An `mk_live_…` key authenticates the REST API at https://api.markifact.com/v1
# only — connections, credit balance and operation logs, which is what the tab
# shows. The 500+ marketing operations (reports, metrics) are MCP-only and
# reject this key: they need OAuth 2.1 + PKCE through an MCP client, which a
# Netlify Function cannot do. Organic search and feed metrics therefore come
# from Google directly, via the GSC_* and GMC_* variables above.
MARKIFACT_API_KEY=

# Mailchimp Marketing API (Email tab — campaign performance and audiences)
# Mailchimp → Account & billing → Extras → API keys. The key ends in the data
# centre that serves the account, e.g. `…-us11`.
MAILCHIMP_API_KEY=
# The suffix on the key above, on its own. Left blank it is read off the key,
# so this is only needed if that suffix is ever absent.
MAILCHIMP_SERVER_PREFIX=
#
# Note: campaign revenue is NOT read from Mailchimp. Its e-commerce
# attribution reports zero for every campaign on this account — the one
# connected store does not cover the audiences being mailed — so the Email tab
# shows engagement only. Orders from list members come from the Make.com sheet
# behind LEADS_SHEET_ID, on the Lead Data tab.

# Flodesk (Email tab — list health only)
# Flodesk → Account → Integrations → Flodesk API. Authenticates as HTTP basic
# with the whole key as the username and no password; a bearer token is
# rejected with a bare 401 that does not say the scheme is wrong.
#
# Note: Flodesk publishes NO engagement data. Its API has no reporting
# endpoint, and `/campaigns` returns a name, a status and two timestamps with
# no opens, clicks or recipient count on it. The Email tab therefore shows
# Flodesk subscribers, segments and a send log only — the open and click rates
# there are Mailchimp's. Its subscriber endpoint also ignores every date
# parameter, so those counts are current state rather than the period on
# screen. Flodesk signups and the orders they produced come from the Make.com
# sheet behind LEADS_SHEET_ID, on the Lead Data tab.
FLODESK_API_KEY=

# OpenAI (Insights tab)
OPENAI_API_KEY=
# Optional. Any Chat Completions model; defaults to gpt-5.4.
OPENAI_MODEL=
