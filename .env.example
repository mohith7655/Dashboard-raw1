# ---------------------------------------------------------------------------
# Server-side secrets. These are read by the Netlify Functions in
# netlify/functions/ and are NEVER exposed to the browser.
#
# Do not prefix any of these with VITE_ — Vite inlines VITE_* variables into
# the public JavaScript bundle, which would publish your credentials.
# ---------------------------------------------------------------------------

# Metorik (WooCommerce revenue, orders, customers, costs)
METORIK_API_KEY=

# Facebook Meta Ads (Marketing Insights API)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# Client-side switch (safe to expose — it holds no secret).
# `true`  → the app renders typed fixture data, no credentials needed.
# `false` → the app calls the Netlify Functions above.
# Defaults to true when unset.
# ---------------------------------------------------------------------------
VITE_USE_FIXTURES=true
