# Template only — never put real values in this file, it is tracked in git.
# Copy it to `.env` (gitignored) for local development, and set the real
# values in Netlify under Project configuration → Environment variables.
#
# These are read by Netlify Functions and are never exposed to the browser.
# Do not prefix secrets with `VITE_`.

# Metorik (WooCommerce revenue, orders, customers, costs)
METORIK_API_KEY=

# Facebook Meta Ads (Marketing Insights API)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Only when the account is reached through a manager (MCC) account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Google Analytics 4 (Traffic tab breakdowns)
# Numeric property id, not the G-XXXXXXX measurement id.
GA4_PROPERTY_ID=
# Needs the analytics.readonly scope. An Ads-only token will not work here —
# run `npm run ga4:auth` to mint one that carries it.
# Falls back to the GOOGLE_ADS_* values when left blank.
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REFRESH_TOKEN=

# OpenAI (Insights tab)
OPENAI_API_KEY=
# Optional. Any Chat Completions model; defaults to gpt-5.4.
OPENAI_MODEL=
